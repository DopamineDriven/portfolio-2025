{
  "name": "@portfolio/root",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "build:chess-v2": "turbo build --filter=@portfolio/chess-v2",
    "build:eslint": "turbo build --filter=@portfolio/eslint-config",
    "build:pong": "turbo build --filter=@portfolio/pong",
    "build:prettier": "turbo build --filter=@portfolio/prettier-config",
    "build:targeted": "pnpm install && pnpm build:eslint && pnpm build:prettier && pnpm build:vitest && pnpm build:types && pnpm build:ui",
    "build:vitest": "turbo build --filter=@portfolio/vitest-config",
    "build:types": "turbo build --filter=@portfolio/types",
    "build:ui": "turbo build --filter=@portfolio/ui",
    "build:web": "turbo build --filter=@portfolio/web",
    "changeset": "changeset",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo dev --parallel --continue",
    "format": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,mjs,cjs,json,yaml,yml,css,html,md,mdx}\" --ignore-unknown --cache",
    "lint": "turbo lint",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "clean:house": "bash ./manage.sh clean:house",
    "gen:web": "pnpm --filter=@portfolio/web typegen",
    "gen:chess-v2": "pnpm --filter=@portfolio/chess-v2 typegen",
    "gen:pong": "pnpm --filter=@portfolio/pong typegen",
    "postclean:house": "pnpm gen:web && pnpm gen:pong && pnpm gen:chess-v2",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "generate:base64": "openssl rand -base64 64",
    "generate:hex": "openssl rand -hex 64",
    "npm:registry": "npm set registry https://registry.npmjs.org",
    "redis:cli": "docker exec -it portfolio_redis redis-cli",
    "run:chess-v2": "turbo dev --filter=@portfolio/chess-v2",
    "run:pong": "turbo dev --filter=@portfolio/pong",
    "run:web": "turbo dev --filter=@portfolio/web",
    "run:docker:web": "pnpm docker:up && pnpm run:web",
    "sync:time": "sudo ntpdate time.windows.com",
    "restore:git": "java -jar ~/bfg.jar --delete-files 'Rubber001_8K-JPG_NormalGL.jpg'",
    "wsl2:info": "lsb_release -d"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:biome",
    "@changesets/cli": "catalog:utils",
    "@portfolio/prettier-config": "workspace:*",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo",
    "dotenv": "catalog:dotenv",
    "husky": "catalog:utils",
    "jiti": "catalog:jiti",
    "prettier": "catalog:prettier",
    "tsx": "catalog:tsx",
    "turbo": "catalog:turbo",
    "typescript": "catalog:ts"
  },
  "prettier": "@portfolio/prettier-config",
  "engines": {
    "node": ">=24",
    "npm": ">=11",
    "pnpm": ">=11"
  }
}
